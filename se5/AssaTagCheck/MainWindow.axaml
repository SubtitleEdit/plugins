<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:local="using:SubtitleEdit.Plugins.AssaTagCheck"
        x:Class="SubtitleEdit.Plugins.AssaTagCheck.MainWindow"
        x:DataType="local:MainViewModel"
        mc:Ignorable="d"
        Title="ASSA tag check"
        Width="1280" Height="840"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#7C5CFF" />
            <GradientStop Offset="1" Color="#06B6D4" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="ErrorTint" Color="#1FE5484D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E08A00" />
        <SolidColorBrush x:Key="WarningTint" Color="#1FE08A00" />
        <SolidColorBrush x:Key="TidyBrush" Color="#12A594" />
        <SolidColorBrush x:Key="TidyTint" Color="#1F12A594" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="AccentTint" Color="#1F7C5CFF" />
        <SolidColorBrush x:Key="RemovedTint" Color="#12E5484D" />
        <SolidColorBrush x:Key="RemovedBorder" Color="#40E5484D" />
        <SolidColorBrush x:Key="AddedTint" Color="#1212A594" />
        <SolidColorBrush x:Key="AddedBorder" Color="#4012A594" />
        <SolidColorBrush x:Key="CardBrush" Color="#0C808080" />
        <SolidColorBrush x:Key="CardBorder" Color="#26808080" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14808080" />
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.code, local|TagTextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{StaticResource CardBorder}" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,7,14,7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.stat.empty">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.rule:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        </Style>
        <Style Selector="Border.rule.off">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.count">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.count:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton.filter">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.lines">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.line">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.line.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.textbox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="50" Height="50" CornerRadius="14" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                    <i:Icon Value="mdi-code-braces-box" FontSize="28" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="ASSA tag check" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="badge" Background="{StaticResource AccentTint}" VerticalAlignment="Center">
                            <TextBlock Text="{}{\an8\pos(…)}" Classes="code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SubtitleInfo}" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="stat" Classes.empty="{Binding !HasErrors}" Background="{StaticResource ErrorTint}" BorderBrush="{StaticResource ErrorTint}"
                            ToolTip.Tip="Lines with broken tags">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-close-octagon" Foreground="{StaticResource ErrorBrush}" FontSize="18" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding ErrorCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                                <TextBlock Text="errors" FontSize="10" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="stat" Classes.empty="{Binding !HasWarnings}" Background="{StaticResource WarningTint}" BorderBrush="{StaticResource WarningTint}"
                            ToolTip.Tip="Lines with conflicting tags or missing styles">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-alert" Foreground="{StaticResource WarningBrush}" FontSize="18" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding WarningCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="warnings" FontSize="10" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="stat" Classes.empty="{Binding !HasTidy}" Background="{StaticResource TidyTint}" BorderBrush="{StaticResource TidyTint}"
                            ToolTip.Tip="Lines with tags that do nothing">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-broom" Foreground="{StaticResource TidyBrush}" FontSize="18" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding TidyCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TidyBrush}" />
                                <TextBlock Text="to tidy" FontSize="10" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <i:Icon Value="mdi-information-outline" FontSize="16" Opacity="0.6" />
                    <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCancel" MinWidth="96">
                        <TextBlock Text="Cancel" HorizontalAlignment="Center" />
                    </Button>
                    <Button Click="OnOk" Classes="accent" MinWidth="130" IsDefault="True" IsEnabled="{Binding CanApply}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <i:Icon Value="mdi-auto-fix" FontSize="16" />
                            <TextBlock Text="Fix selected" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="350" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="14,16,16,18" Spacing="18">

                    <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-format-list-checks" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="RULES" Classes="section" Opacity="0.7" />
                            <Border Classes="badge" VerticalAlignment="Center">
                                <TextBlock FontSize="11"><Run Text="{Binding EnabledRuleCount}" /><Run Text=" on" /></TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="link" Command="{Binding EnableAllCommand}" Content="All" ToolTip.Tip="Turn on every rule" />
                            <Button Classes="link" Command="{Binding ErrorsOnlyCommand}" Content="Errors only" ToolTip.Tip="Only check for broken tags" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:RuleSection">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0,4,4">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Tint}">
                                            <i:Icon Value="{Binding Icon}" FontSize="13" Foreground="{Binding Brush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" Classes="section" Foreground="{Binding Brush}" />
                                            <Border Classes="chip" Padding="7,1" Background="{Binding Tint}" IsVisible="{Binding HasCount}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                            </Border>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding AllEnabled}" MinWidth="0" Padding="0"
                                                  ToolTip.Tip="Turn every rule in this group on or off" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:RuleOption">
                                                <Border Classes="rule" Classes.off="{Binding !IsEnabled}" PointerPressed="OnRulePressed"
                                                        ToolTip.Placement="Right" ToolTip.ShowDelay="300">
                                                    <ToolTip.Tip>
                                                        <StackPanel Spacing="10" MaxWidth="380" Margin="2,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Classes="tile" Width="28" Height="28" Background="{Binding Tint}">
                                                                    <i:Icon Value="{Binding Icon}" Foreground="{Binding Brush}" FontSize="16" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                            <StackPanel Spacing="5">
                                                                <TextBlock Text="EXAMPLE" Classes="section" FontSize="10" Opacity="0.7" />
                                                                <Border Classes="textbox" Background="{StaticResource RemovedTint}" BorderBrush="{StaticResource RemovedBorder}">
                                                                    <local:TagTextBlock Segments="{Binding ExampleBefore}" FontSize="13" TextWrapping="Wrap" />
                                                                </Border>
                                                                <Border Classes="textbox" Background="{StaticResource AddedTint}" BorderBrush="{StaticResource AddedBorder}"
                                                                        IsVisible="{Binding ExampleIsFixable}">
                                                                    <local:TagTextBlock Segments="{Binding ExampleAfter}" FontSize="13" TextWrapping="Wrap" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ExampleMessage}" FontSize="12" TextWrapping="Wrap" Classes="muted"
                                                                           IsVisible="{Binding HasExampleMessage}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <i:Icon Value="{Binding FixKindIcon}" FontSize="13" Foreground="{Binding Brush}" />
                                                                <TextBlock Text="{Binding FixKindText}" FontSize="11" Classes="muted" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ToolTip.Tip>
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Border Classes="tile" Background="{Binding Tint}">
                                                            <i:Icon Value="{Binding Icon}" Foreground="{Binding Brush}" FontSize="18" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="11,0,6,0" VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                        <Border Grid.Column="2" Classes="chip count" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Background="{Binding Tint}" IsVisible="{Binding HasCount}"
                                                                ToolTip.Tip="Show only these lines">
                                                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                                        </Border>
                                                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                                                      VerticalAlignment="Center" MinWidth="0" Margin="0,-6" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="8" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-target" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="CHECK" Classes="section" Opacity="0.7" />
                        </StackPanel>
                        <RadioButton GroupName="scope" IsChecked="{Binding AllLines}" Content="All lines" />
                        <RadioButton GroupName="scope" IsChecked="{Binding SelectedLinesOnly}" Content="{Binding SelectedLinesText}"
                                     IsEnabled="{Binding HasSelectedLines}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Lines -->
        <DockPanel Margin="20,16,20,0">

            <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding IsNotAssa}"
                    Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentTint}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <i:Icon Value="mdi-information-variant-circle-outline" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding NotAssaText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ScriptIssues}" IsVisible="{Binding HasScriptIssues}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ScriptIssue">
                        <Border Classes="card" Padding="12,10" Background="{StaticResource WarningTint}" BorderBrush="{StaticResource WarningTint}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="tile" Background="{StaticResource WarningTint}">
                                    <i:Icon Value="mdi-format-font" FontSize="18" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsVisible="{Binding HasLines}">
                <TextBox Text="{Binding SearchText}" Watermark="Search text, tag or line number" Width="320" HorizontalAlignment="Left">
                    <TextBox.InnerLeftContent>
                        <i:Icon Value="mdi-magnify" FontSize="16" Opacity="0.55" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="Select every visible fixable line">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-marked-outline" FontSize="16" />
                            <TextBlock Text="Select all" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="Clear the selection of the visible lines">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-blank-outline" FontSize="16" />
                            <TextBlock Text="None" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding InvertSelectionCommand}" ToolTip.Tip="Invert the selection of the visible lines">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-select-inverse" FontSize="16" />
                            <TextBlock Text="Invert" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Filters}" Margin="0,0,0,8" IsVisible="{Binding HasLines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FilterChip">
                        <ToggleButton Classes="filter" Margin="0,0,6,6" IsChecked="{Binding IsActive, Mode=OneWay}"
                                      Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SetFilterCommand}"
                                      CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="{Binding Icon}" FontSize="14" Foreground="{Binding Brush}" />
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Opacity="0.6" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty states -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsClean}" HorizontalAlignment="Center" Margin="0,110,0,0" Spacing="10">
                <Border Width="92" Height="92" CornerRadius="46" Background="{StaticResource TidyTint}" HorizontalAlignment="Center">
                    <i:Icon Value="mdi-check-decagram-outline" FontSize="50" Foreground="{StaticResource TidyBrush}" />
                </Border>
                <TextBlock Text="{Binding CleanTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CleanText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsFilteredEmpty}" HorizontalAlignment="Center" Margin="0,100,0,0" Spacing="10">
                <i:Icon Value="mdi-magnify-close" FontSize="44" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="No lines match the search" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox Classes="lines" ItemsSource="{Binding VisibleLines}" IsVisible="{Binding HasVisibleLines}" Padding="0,0,8,6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:LineItem">
                        <Border Classes="line" Classes.off="{Binding !IsSelected}">
                            <Grid ColumnDefinitions="4,Auto,*">
                                <Border Background="{Binding AccentBrush}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsFixable}"
                                          VerticalAlignment="Top" Margin="12,10,0,0" ToolTip.Tip="Fix this line" />
                                <StackPanel Grid.Column="2" Margin="6,12,14,12" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Classes="badge" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Number}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Opacity="0.65">
                                            <i:Icon Value="mdi-clock-outline" FontSize="13" />
                                            <TextBlock Text="{Binding TimeRange}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        </StackPanel>
                                        <Border Classes="badge" VerticalAlignment="Center" IsVisible="{Binding HasStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <i:Icon Value="mdi-palette-swatch-outline" FontSize="12" />
                                                <TextBlock FontSize="11" Text="{Binding StyleBefore}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="badge" VerticalAlignment="Center" IsVisible="{Binding StyleChanged}" Background="{StaticResource AddedTint}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <i:Icon Value="mdi-swap-horizontal" FontSize="12" Foreground="{StaticResource TidyBrush}" />
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StyleChangeText}" Foreground="{StaticResource TidyBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="badge" VerticalAlignment="Center" IsVisible="{Binding IsManualOnly}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <i:Icon Value="mdi-hand-back-right-outline" FontSize="12" />
                                                <TextBlock FontSize="11" Text="Fix by hand" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Issues}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:IssueRow">
                                                <Grid ColumnDefinitions="Auto,Auto,*">
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Tint}" VerticalAlignment="Top">
                                                        <i:Icon Value="{Binding Icon}" FontSize="13" Foreground="{Binding Brush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{Binding Brush}" Margin="8,2,10,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.85" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding TextChanged}">
                                        <Border Classes="textbox" Background="{StaticResource RemovedTint}" BorderBrush="{StaticResource RemovedBorder}">
                                            <local:TagTextBlock Segments="{Binding BeforeSegments}" FontSize="14" TextWrapping="Wrap" />
                                        </Border>
                                        <i:Icon Grid.Column="1" Value="mdi-arrow-right" FontSize="18" Opacity="0.45" Margin="10,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="textbox" Background="{StaticResource AddedTint}" BorderBrush="{StaticResource AddedBorder}">
                                            <local:TagTextBlock Segments="{Binding AfterSegments}" FontSize="14" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                    <Border Classes="textbox" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}"
                                            IsVisible="{Binding ShowSingleText}">
                                        <local:TagTextBlock Segments="{Binding BeforeSegments}" FontSize="14" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
