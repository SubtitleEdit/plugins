<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrazilianToEuropeanPortuguese</AssemblyName>
    <RootNamespace>SubtitleEdit.Plugins.BrazilianToEuropeanPortuguese</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin-Shared\Plugin-Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PortugueseWordList.xml" LogicalName="PortugueseWordList.xml" />
    <EmbeddedResource Include="Dictionaries/*.tar.gz" LogicalName="BrazilianToEuropeanPortuguese.Dictionaries.%(Filename)%(Extension)" />
    <Content Include="Dictionaries/*.tar.gz" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" GeneratePathProperty="true" />
    <Content Include="$(PkgWeCantSpell_Hunspell)/license.txt" Link="Dictionaries/Hunspell-license.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Subtitle Edit only lists the plugin when plugin.json is next to the executable. -->
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.pt-PT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="TransportVocabulary.pt-PT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="srt-processing.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A self-contained publish has no "dotnet" host: point plugin.json at the native executable,
       as the release workflow does, so Subtitle Edit works where .NET is not installed (e.g. Docker). -->
  <Target Name="WriteSelfContainedPluginManifest" AfterTargets="Publish"
          Condition="'$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_PluginOs Condition="$(RuntimeIdentifier.StartsWith('win'))">windows</_PluginOs>
      <_PluginOs Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</_PluginOs>
      <_PluginOs Condition="$(RuntimeIdentifier.StartsWith('osx'))">macos</_PluginOs>
      <_PluginExe>$(AssemblyName)</_PluginExe>
      <_PluginExe Condition="'$(_PluginOs)' == 'windows'">$(AssemblyName).exe</_PluginExe>
      <_PluginManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/plugin.json'))</_PluginManifest>
      <_PluginManifest>$([System.Text.RegularExpressions.Regex]::Replace($(_PluginManifest), '"runtime":\s*"dotnet",\s*"entry":\s*"[^"]*"', '"executables": { "$(_PluginOs)": "$(_PluginExe)" }'))</_PluginManifest>
    </PropertyGroup>
    <Error Condition="'$(_PluginOs)' == '' or !$(_PluginManifest.Contains('&quot;executables&quot;'))"
           Text="Could not write a self-contained plugin.json for $(RuntimeIdentifier)." />
    <WriteLinesToFile File="$(PublishDir)plugin.json" Lines="$([MSBuild]::Escape($(_PluginManifest)))" Overwrite="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="BrazilianToEuropeanPortuguese.Tests" />
  </ItemGroup>

</Project>
