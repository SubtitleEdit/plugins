<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:SubtitleEdit.Plugins.BrazilianToEuropeanPortuguese"
        x:Class="SubtitleEdit.Plugins.BrazilianToEuropeanPortuguese.WordListWindow"
        mc:Ignorable="d"
        Title="Local word list"
        Width="560" Height="520"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">

        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,14,0,0">
            <SelectableTextBlock Grid.Column="0"
                                 x:Name="FileLabel"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 Margin="0,0,12,0" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Click="OnCancel"
                    MinWidth="100"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Content="OK"
                    Click="OnOk"
                    MinWidth="100"
                    Classes="accent"
                    IsDefault="True" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   x:Name="ErrorLabel"
                   Foreground="#FFE05050"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   IsVisible="False" />

        <TabControl>
            <TabItem Header="Custom words">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Extra conversions, used together with the built-in list. A custom word replaces a built-in pair with the same Brazilian word. Phrases are allowed; case is kept (geladeira → frigorífico also turns Geladeira into Frigorífico)." />
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="*,*,Auto,Auto"
                          Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 x:Name="BrazilianBox"
                                 Watermark="Brazilian (pt-BR)"
                                 Margin="0,0,6,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="PortugueseBox"
                                 Watermark="European (pt-PT)"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="2"
                                Content="Add"
                                Click="OnAddWord"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="3"
                                x:Name="RemoveWordButton"
                                Content="Remove"
                                Click="OnRemoveWord"
                                IsEnabled="False" />
                    </Grid>
                    <Border BorderBrush="#22808080" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="WordsList"
                                 Background="Transparent"
                                 SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:WordPair">
                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Brazilian}" />
                                        <TextBlock Grid.Column="1" Text="→" Opacity="0.5" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding European}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Ignored words">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Brazilian words from the built-in list that should never be converted, or whole phrases to leave untouched (e.g. a name such as &quot;Tá Bom Bar&quot;)." />
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="*,Auto,Auto"
                          Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 x:Name="IgnoreBox"
                                 Watermark="Brazilian word or phrase"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="Add"
                                Click="OnAddIgnored"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="2"
                                x:Name="RemoveIgnoredButton"
                                Content="Remove"
                                Click="OnRemoveIgnored"
                                IsEnabled="False" />
                    </Grid>
                    <Border BorderBrush="#22808080" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="IgnoredList"
                                 Background="Transparent"
                                 SelectionMode="Multiple" />
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
