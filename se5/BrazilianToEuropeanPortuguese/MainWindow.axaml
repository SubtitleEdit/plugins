<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:SubtitleEdit.Plugins.BrazilianToEuropeanPortuguese"
        x:Class="SubtitleEdit.Plugins.BrazilianToEuropeanPortuguese.MainWindow"
        mc:Ignorable="d"
        Title="Brazilian to European Portuguese"
        Width="1120" Height="760"
        MinWidth="1000" MinHeight="560"
        SizeChanged="OnWindowSizeChanged"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">

        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,14,0,0">
            <TextBlock Grid.Column="0"
                       x:Name="SummaryLabel"
                       VerticalAlignment="Center"
                       Opacity="0.75" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Click="OnCancel"
                    MinWidth="100"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    x:Name="ApplyButton"
                    Content="Apply"
                    Click="OnApply"
                    MinWidth="100"
                    Classes="accent"
                    IsDefault="True" />
        </Grid>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,4">
            <StackPanel Grid.Column="0" x:Name="SelectButtons" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Select all" Click="OnSelectAll"
                            ToolTip.Tip="Select all corrections, including hidden rows." />
                    <Button Content="Select none" Click="OnSelectNone"
                            ToolTip.Tip="Deselect all corrections, including hidden rows." />
                </StackPanel>
                <WrapPanel ToolTip.Tip="Show matching finding types. Filtering does not change what Apply includes.">
                    <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ToggleButton x:Name="RuleBasedFilter" Content="Rule-based changes" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4" />
                    <ToggleButton x:Name="MiniLmFilter" Content="MiniLM warnings" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4" />
                    <ToggleButton x:Name="JudgeFilter" Content="Gervásio choices" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4" />
                    <ToggleButton x:Name="GrammarFilter" Content="Grammar warnings" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4"
                                  ToolTip.Tip="Show LanguageTool grammar findings independently of other review warnings. Does not change which rules run or which corrections Apply includes." />
                    <ToggleButton x:Name="OtherReviewFilter" Content="Other review warnings" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4" />
                    <ToggleButton x:Name="ManualEditFilter" Content="Manual edits" IsChecked="True"
                                  Click="OnFindingFilterChanged" Margin="0,0,6,4" />
                </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="SettingsToggleButton"
                    Click="OnToggleSettings"
                    ToolTip.Tip="Collapse settings to show more subtitle lines"
                    AutomationProperties.Name="Collapse settings"
                    Padding="8,6" Margin="0,0,8,0">
                <PathIcon x:Name="SettingsToggleIcon" Width="16" Height="16"
                          Data="M 2,11 L 8,5 L 14,11" />
            </Button>
            <Button Grid.Column="2"
                    x:Name="EditNameArticlesButton"
                    Content="Personal name articles…"
                    Click="OnEditNameArticles"
                    ToolTip.Tip="Choose articles for names used by supported conversion rules."
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    x:Name="ContributeVocabularyButton"
                    Content="Contribute vocabulary / Local word list"
                    Click="OnContributeVocabulary"
                    ToolTip.Tip="Contribute suggestions without changing conversion, or manage active custom and ignored words locally."
                    Margin="0,0,8,0" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" x:Name="SettingsPanel">
        <Grid x:Name="SettingsColumns" ColumnDefinitions="55*,45*" Margin="0,0,0,8">
        <ScrollViewer Grid.Column="0" x:Name="ConversionSettingsContent" MaxHeight="400"
                      Margin="0,0,12,0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <TextBlock
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Brazilian to European Portuguese" />

        <TextBlock DockPanel.Dock="Top"
                   x:Name="SubtitleLabel"
                   Margin="0,4,0,12"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <WrapPanel DockPanel.Dock="Top"
                   x:Name="OptionsPanel"
                   Margin="0,0,0,12"
                   Orientation="Horizontal">
            <CheckBox x:Name="SpellingCheck" Content="Spelling" Margin="0,0,16,0"
                      ToolTip.Tip="facto, receção, económico, género, bebé, connosco, dezasseis..." />
            <CheckBox x:Name="VocabularyCheck" Content="Vocabulary" Margin="0,0,16,0"
                      ToolTip.Tip="ônibus → autocarro, trem → comboio, celular → telemóvel, banheiro → casa de banho..." />
            <CheckBox x:Name="ProgressiveCheck" Content="estar a + infinitive" Margin="0,0,16,0"
                      ToolTip.Tip="estou fazendo → estou a fazer" />
            <CheckBox x:Name="PronounsCheck" Content="Pronoun placement" Margin="0,0,16,0"
                      ToolTip.Tip="Me diga → Diga-me, Eu te amo → Eu amo-te, vou te ajudar → vou ajudar-te, vi ele → vi-o" />
            <CheckBox x:Name="ColloquialCheck" Content="Colloquial" Margin="0,0,16,0"
                      ToolTip.Tip="tá → está, pra → para, ter que → ter de, cadê → onde está, oi → olá..." />
            <CheckBox x:Name="YouToTuCheck" Content="você → tu"
                      ToolTip.Tip="você tem → tu tens, com você → contigo, para você → para ti (unknown verbs are left alone)" />
        </WrapPanel>

        <CheckBox x:Name="AskNameArticlesCheck"
                  Content="Ask about unknown personal name articles (preview only)"
                  IsCheckedChanged="OnOptionChanged"
                  ToolTip.Tip="Ask once per unresolved name when a supported rule needs an article. Batch convert never asks."
                  Margin="0,0,0,8" />

        <Grid x:Name="OrthographyControls" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <WrapPanel Grid.Column="0">
            <TextBlock Text="Orthography:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="OrthographyChoice" SelectedIndex="0" Margin="0,0,12,0"
                      SelectionChanged="OnOrthographyChanged">
                <ComboBoxItem Content="Post-1990 agreement (AO90)" />
                <ComboBoxItem Content="Pre-1990 agreement" />
            </ComboBox>
            <CheckBox x:Name="ValidateSpellingCheck" Content="Validate spelling"
                      IsCheckedChanged="OnOptionChanged"
                      ToolTip.Tip="Flag words not recognised by the selected Natura dictionary; never auto-correct them." />
            <Button x:Name="DictionaryCheckButton" Content="Check dictionary updates"
                    Click="OnCheckDictionary" Margin="8,0,8,0" />
        </WrapPanel>
            <Button Grid.Column="1" x:Name="DictionaryDownloadButton" Content="Re-download dictionary"
                    VerticalAlignment="Bottom"
                    Click="OnDownloadDictionary" />
        </Grid>
        <ScrollViewer MaxHeight="80" Margin="0,0,0,8">
            <TextBlock x:Name="DictionaryStatus" TextWrapping="Wrap" Opacity="0.75"
                       Text="Natura dictionaries available offline (2025-10-01)." />
        </ScrollViewer>
        <Grid x:Name="ReviewLayoutPanels" ColumnDefinitions="180,*">
        <Expander Grid.Column="0" x:Name="ReviewTools" Header="Review tools"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,12,0">
            <StackPanel Spacing="6">
                <ComboBox x:Name="DisableRuleChoice" HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a rule stage" />
                <WrapPanel>
                    <Button x:Name="DisableRuleButton" Content="Disable for this file" Click="OnDisableRule" Margin="0,0,8,6" />
                    <Button x:Name="RestoreRulesButton" Content="Restore file rules" Click="OnRestoreRules" Margin="0,0,0,6" />
                </WrapPanel>
                <Button Content="Export reviewed corrections…" Click="OnExportCorrections" />
                <TextBlock Text="Disabling a stage recomputes the file. Export contains Portuguese text; review for personal information before sharing."
                           TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
        </Expander>
        <Expander Grid.Column="1" x:Name="LayoutTools"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Expander.Header>
                <TextBlock Text="Dialogue context and subtitle layout" TextWrapping="Wrap" />
            </Expander.Header>
            <ScrollViewer x:Name="LayoutContent" MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <WrapPanel>
                    <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="AddressChoice" SelectedIndex="0" SelectionChanged="OnOrthographyChanged">
                        <ComboBoxItem Content="Automatic (context safeguards)" />
                        <ComboBoxItem Content="Informal tu (manual override)" />
                        <ComboBoxItem Content="Formal (manual override)" />
                    </ComboBox>
                </WrapPanel>
                <CheckBox x:Name="ConversationalCheck"
                          IsCheckedChanged="OnOptionChanged"
                          ToolTip.Tip="Paraphrases supported future mesoclisis with ir + infinitive and omits clearly noncontrastive eu/nós. Formal address, conditionals and ambiguous subjects are preserved.">
                    <TextBlock Text="Conversational PT-PT style (optional, off by default)" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="SentenceContextCheck"
                          IsCheckedChanged="OnOptionChanged"
                          ToolTip.Tip="Only short, unformatted continuations without speaker markers. Timings stay unchanged; coupled changes are accepted/rejected together.">
                    <TextBlock Text="Convert complete sentences across adjacent cues (optional)" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="RewrapCheck" Content="Rewrap within each cue (optional)" IsCheckedChanged="OnOptionChanged"
                          ToolTip.Tip="Avoids dangling articles, clitics and auxiliary/infinitive breaks where possible. Tagged text and dialogue markers are not rewrapped." />
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Characters/line:" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="LineLength" Minimum="20" Maximum="100" Value="43" Width="130" Margin="6,0,0,0"
                                       ValueChanged="OnLayoutChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Max lines:" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="MaxLines" Minimum="1" Maximum="4" Value="2" Width="110" Margin="6,0,0,0"
                                       ValueChanged="OnLayoutChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Warning CPS:" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="CharactersPerSecond" Minimum="5" Maximum="60" Value="20" Width="130" Margin="6,0,0,0"
                                       ValueChanged="OnLayoutChanged" />
                    </StackPanel>
                </WrapPanel>
                <CheckBox x:Name="LayoutWarningsCheck"
                          IsCheckedChanged="OnOptionChanged"
                          ToolTip.Tip="Off by default. These warnings do not indicate a translation or grammar error. Language and meaning warnings remain enabled.">
                    <TextBlock Text="Show layout and reading-speed warnings (optional)" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="Timings never change. An infeasible wrap is kept rather than forced; enable layout warnings to flag it."
                           TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            </ScrollViewer>
        </Expander>

        </Grid>
        </StackPanel>
        </ScrollViewer>

        <Expander Grid.Column="1" x:Name="ReferencePanel"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  ToolTip.Tip="An English subtitle of the same episode, found automatically when it is named like the subtitle or video with .en/.eng/.english. It prevents wrong changes (his/her → keeps 'o seu/a sua') and marks you/your lines that kept você/seu for review; it never adds text.">
            <Expander.Header>
                <TextBlock Text="Reference subtitle and local models (optional)" TextWrapping="Wrap" />
            </Expander.Header>
            <ScrollViewer x:Name="ReferenceContent" MaxHeight="350" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <CheckBox x:Name="BatchReferenceCheck" IsVisible="False" IsChecked="True"
                          Content="Use the English subtitle next to each file"
                          ToolTip.Tip="Files without an English subtitle are converted as before." />
                <Grid x:Name="ReferencePathRow" ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" x:Name="ReferencePath" IsReadOnly="True"
                             Watermark="English .srt of the same release (none)" Margin="0,0,8,0" />
                    <Button Grid.Column="1" x:Name="ReferenceBrowseButton" Content="Browse…" Click="OnBrowseReference" Margin="0,0,8,0" />
                    <Button Grid.Column="2" x:Name="ReferenceClearButton" Content="Clear" Click="OnClearReference" />
                </Grid>
                <WrapPanel>
                    <CheckBox x:Name="EmbeddingCheck" Content="Check timing with MiniLM" Margin="0,0,16,0"
                              IsCheckedChanged="OnEmbeddingSettingChanged"
                              ToolTip.Tip="Matches translated lines with a local multilingual model to fix offsets, frame-rate differences and cut scenes. Runs on this computer only." />
                    <CheckBox x:Name="VulkanCheck" Content="Vulkan GPU" Margin="0,0,8,0"
                              IsCheckedChanged="OnEmbeddingSettingChanged"
                              ToolTip.Tip="Unticked: CPU. Ticked: the device below; GPU offload is verified or the run stops." />
                    <ComboBox x:Name="DeviceChoice" MinWidth="220" Margin="0,0,8,0" SelectionChanged="OnDeviceChanged" />
                    <Button x:Name="ListDevicesButton" Content="List devices" Click="OnListDevices" />
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="DownloadModelButton" Content="Download MiniLM model" Click="OnDownloadModel" Margin="0,0,8,4"
                            ToolTip.Tip="paraphrase-multilingual-MiniLM-L12-v2 F16 GGUF (Apache-2.0, 242 MB) from Hugging Face, pinned and SHA-256 verified. Saved in the plugin's own data folder." />
                    <Button x:Name="DownloadRuntimeButton" Content="Download llama-server" Click="OnDownloadRuntime" Margin="0,0,8,4"
                            ToolTip.Tip="llama.cpp b11707 with Vulkan (MIT) from GitHub, pinned and SHA-256 verified. Saved in the plugin's own data folder; replaces an earlier download." />
                    <Button x:Name="ReferenceCancelButton" Content="Stop" Click="OnCancelReference" IsEnabled="False" Margin="0,0,8,4" />
                </WrapPanel>
                <TextBlock Text="Extra checks (local, after the rules)" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="GrammarCheck"
                          IsCheckedChanged="OnGrammarSettingChanged">
                    <TextBlock Text="LanguageTool pt-PT (local grammar checker)" TextWrapping="Wrap" />
                </CheckBox>
                <Button x:Name="GrammarRulesButton" Content="Choose LanguageTool rules..."
                        Click="OnChooseGrammarRules"
                        ToolTip.Tip="Choose alert groups and individual LanguageTool rules. Saved for preview and Batch convert. Run checks again after changing the selection." />
                <WrapPanel>
                    <Button x:Name="DownloadGrammarButton" Content="Download LanguageTool pt-PT (240 MB)"
                            Click="OnDownloadGrammar" Margin="0,0,8,4"
                            ToolTip.Tip="LanguageTool 6.6, LGPL-2.1-or-later; official archive, SHA-256 verified. Includes Portuguese grammar rules. Not a generative model." />
                    <Button x:Name="DownloadJavaButton" Content="Download portable Java (40–50 MB)"
                            Click="OnDownloadJava" Margin="0,0,8,4"
                            ToolTip.Tip="Eclipse Temurin JRE 21.0.13+9, GPLv2 with Classpath Exception; pinned and SHA-256 verified. Plugin-private, no system installation." />
                </WrapPanel>
                <CheckBox x:Name="GrammarExternalServer" Content="Use my own server instead (advanced)"
                          IsCheckedChanged="OnGrammarSettingChanged" />
                <TextBox x:Name="GrammarServer" Watermark="http://127.0.0.1:8081/"
                         TextChanged="OnGrammarServerChanged"
                         ToolTip.Tip="Your self-hosted server URL. Text is sent to this server only. No automatic installation, cloud API or redirects." />
                <CheckBox x:Name="GrammarAutoFix"
                          IsCheckedChanged="OnGrammarSettingChanged"
                          ToolTip.Tip="Off: suggestions only. On: only explicit ele/ela/eles/elas + tem/têm/vem/vêm, after English subject, meaning and grammar rechecks. Other findings remain review notes.">
                    <TextBlock Text="Allow tested agreement fixes (requires English and MiniLM)" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="Download both components once; Run checks starts and stops the local checker automatically. CPU only; no text generation. Suggestions stay review-only unless all automatic-fix safeguards pass."
                           TextWrapping="Wrap" Opacity="0.7" />
                <WrapPanel>
                    <CheckBox x:Name="MeaningCheck" Content="Flag meaning changes (MiniLM)" Margin="0,0,16,0"
                              IsCheckedChanged="OnEmbeddingSettingChanged"
                              ToolTip.Tip="Compares each converted line with the original (and the English reference, if any) using the MiniLM model above, and marks lines whose meaning may have changed for review. Never changes text." />
                    <CheckBox x:Name="JudgeCheck" Content="Gervásio PT-PT judge" Margin="0,0,8,0"
                              IsCheckedChanged="OnEmbeddingSettingChanged"
                              ToolTip.Tip="A European Portuguese language model rates the line as converted against a few fixed alternatives (tem/têm, vem/vêm, mau/má, tira → polícia, miúdo → rapaz for garoto) and keeps the clearly more natural one. It never writes text of its own. Uses the Vulkan device above; layers that do not fit in the GPU stay on the CPU." />
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="DownloadJudgeButton" Content="Download Gervásio PT-PT (4.9 GB)" Click="OnDownloadJudge" Margin="0,0,8,4"
                            ToolTip.Tip="Gervásio 8B PT-PT decoder (University of Lisbon, MIT licence, based on Llama 3.1 8B Instruct), Q4_K_M GGUF from Hugging Face, pinned and SHA-256 verified. Needs llama-server. About 6 GB of GPU memory for full speed; smaller GPUs or the CPU work, more slowly." />
                    <Button x:Name="RunChecksButton" Content="Run checks" Click="OnRunChecks" Margin="0,0,8,4"
                            ToolTip.Tip="Run the ticked checks on the lines shown. They also run automatically when the window opens." />
                </WrapPanel>
                <TextBlock x:Name="AssetStatus" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                <TextBlock x:Name="ReferenceStatus" TextWrapping="Wrap" Opacity="0.75"
                           Text="No reference. Pick the English subtitle of the same release to protect 'o seu/a sua' when the English says his/her/their." />
            </StackPanel>
            </ScrollViewer>
        </Expander>
        </Grid>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   x:Name="NoChangesLabel"
                   FontSize="14"
                   Margin="0,30,0,0"
                   HorizontalAlignment="Center"
                   Opacity="0.65"
                   Text="No Brazilian Portuguese found to convert in the selected lines."
                   IsVisible="False" />

        <!-- Configure (Batch convert) -->
        <StackPanel DockPanel.Dock="Top"
                    x:Name="ConfigurePanel"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    Spacing="10"
                    MaxWidth="520">
            <TextBlock Text="Batch convert settings"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Opacity="0.7"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="Batch convert converts every line of each file with the rule groups ticked above, using the built-in word list plus your local word list, without showing this window. With the English reference, lines to review are counted in each file's status. Use Contribute vocabulary / Local word list to save custom or ignored entries, then click OK." />
        </StackPanel>

        <Border x:Name="ChangesBorder"
                BorderBrush="#22808080"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            <!-- Not a ListBox: selecting a row did nothing, and recycled rows of different heights left ghosts while scrolling. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ChangesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ChangeProposal">
                        <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="8,6"
                                IsVisible="{Binding VisibleInReview}">
                        <Grid ColumnDefinitions="32,42,*,300">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Include, Mode=TwoWay}"
                                      IsEnabled="{Binding IsChange}"
                                      ToolTip.Tip="Include this text change. If disabled, the text is unchanged; edit the line to propose a correction."
                                      AutomationProperties.Name="Include text change"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LineNumber}"
                                       Opacity="0.55"
                                       FontSize="12"
                                       Margin="6,2,8,0"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding OriginalText, StringFormat='PT-BR: {0}'}"
                                           TextWrapping="Wrap"
                                           Opacity="0.55"
                                           FontSize="12" />
                                <TextBox Text="{Binding ConvertedText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontWeight="SemiBold"
                                         Padding="4,2"
                                         ToolTip.Tip="Edit this line by hand; what you type is what gets applied." />
                                <TextBlock Text="{Binding ReferenceText}"
                                           IsVisible="{Binding HasReference}"
                                           TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           Opacity="0.55"
                                           FontSize="12" />
                                <TextBlock Text="{Binding ReviewNote}"
                                           IsVisible="{Binding HasReview}"
                                           TextWrapping="Wrap"
                                           Foreground="#E0A030"
                                           FontSize="12" />
                                <CheckBox Content="Include layout change" IsVisible="{Binding HasLayoutChange}"
                                          IsChecked="{Binding IncludeLayout, Mode=TwoWay}" />
                            </StackPanel>
                                <Expander Grid.Column="3" Header="Rules and regression export"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Explanation}" IsVisible="{Binding HasExplanation}"
                                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="Expected PT-PT for export only (does not edit the applied subtitle):"
                                                   TextWrapping="Wrap" FontSize="12" />
                                        <TextBox Text="{Binding ExpectedText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
