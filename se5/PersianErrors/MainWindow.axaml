<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:local="using:SubtitleEdit.Plugins.PersianErrors"
        x:Class="SubtitleEdit.Plugins.PersianErrors.MainWindow"
        x:DataType="local:MainViewModel"
        mc:Ignorable="d"
        Title="Persian Subtitle Fixes"
        Width="1240" Height="820"
        MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#0EA5A4" />
            <GradientStop Offset="1" Color="#7C5CFF" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FixBrush" Color="#2FA36B" />
        <SolidColorBrush x:Key="FixTint" Color="#1F2FA36B" />
        <SolidColorBrush x:Key="RemovedTint" Color="#14E5484D" />
        <SolidColorBrush x:Key="RemovedBorder" Color="#40E5484D" />
        <SolidColorBrush x:Key="AddedTint" Color="#142FA36B" />
        <SolidColorBrush x:Key="AddedBorder" Color="#402FA36B" />
        <SolidColorBrush x:Key="HiddenBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#0C808080" />
        <SolidColorBrush x:Key="CardBorder" Color="#26808080" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14808080" />
        <FontFamily x:Key="PersianFont">Vazirmatn, Segoe UI, Tahoma, Geeza Pro, Noto Naskh Arabic, Noto Sans Arabic, DejaVu Sans, Arial</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.persian, local|DiffTextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PersianFont}" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{StaticResource CardBorder}" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.group:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        </Style>
        <Style Selector="Border.group.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton.filter">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.fixes">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.fixes ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.fixes ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.fixes ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.fixes ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.fix">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.fix.off">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.textbox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                    <i:Icon Value="mdi-abjad-arabic" FontSize="27" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Persian Subtitle Fixes" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="اصلاح خطاهای رایج زیرنویس فارسی" Classes="persian muted" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SubtitleInfo}" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="chip" Background="{StaticResource CardBorder}" IsVisible="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressBar Value="{Binding Progress}" Width="90" MinWidth="90" VerticalAlignment="Center" />
                            <TextBlock Text="Checking..." FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Classes="chip" Background="{StaticResource FixTint}" IsVisible="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-auto-fix" Foreground="{StaticResource FixBrush}" FontSize="15" />
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource FixBrush}">
                                <Run Text="{Binding FixCount}" /><Run Text=" fixes" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Classes="chip" Background="{StaticResource CardBorder}" IsVisible="{Binding HasChanges}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-check-all" FontSize="15" />
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding ChangedLineCount}" /><Run Text=" lines changed" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <i:Icon Value="mdi-information-outline" FontSize="16" Opacity="0.6" />
                    <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo the last applied pass">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-undo" FontSize="16" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyAndRecheckCommand}" IsEnabled="{Binding CanApply}"
                            ToolTip.Tip="Apply the selected fixes and check again - one fix can open the way for another">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-auto-fix" FontSize="16" />
                            <TextBlock Text="Apply and re-check" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCancel" MinWidth="96">
                        <TextBlock Text="Cancel" HorizontalAlignment="Center" />
                    </Button>
                    <Button Click="OnOk" Classes="accent" MinWidth="110" IsDefault="True" IsEnabled="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <i:Icon Value="mdi-check" FontSize="16" />
                            <TextBlock Text="OK" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="340" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="16,18,18,18" Spacing="22">

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="mdi-format-list-checks" FontSize="16" Opacity="0.7" />
                                <TextBlock Text="FIX GROUPS" Classes="section" />
                                <Border Classes="badge" VerticalAlignment="Center">
                                    <TextBlock FontSize="11"><Run Text="{Binding EnabledGroupCount}" /><Run Text=" on" /></TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Classes="link" Command="{Binding EnableAllGroupsCommand}" Content="All" ToolTip.Tip="Turn on every group" />
                                <Button Classes="link" Command="{Binding DisableAllGroupsCommand}" Content="None" ToolTip.Tip="Turn off every group" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupOption">
                                    <Border Classes="group" Classes.off="{Binding !IsEnabled}" PointerPressed="OnGroupPressed"
                                            ToolTip.Placement="Right" ToolTip.ShowDelay="350">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="10" MaxWidth="340" Margin="2,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <i:Icon Value="{Binding Icon}" Foreground="{Binding Brush}" FontSize="18" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <StackPanel Spacing="4" IsVisible="{Binding HasExample}">
                                                    <TextBlock Text="EXAMPLE" Classes="section" FontSize="10" />
                                                    <Grid ColumnDefinitions="*,Auto,*">
                                                        <Border Classes="textbox" Background="{StaticResource RemovedTint}" BorderBrush="{StaticResource RemovedBorder}">
                                                            <local:DiffTextBlock Segments="{Binding ExampleBefore}" FontSize="15" />
                                                        </Border>
                                                        <i:Icon Grid.Column="1" Value="mdi-arrow-right" FontSize="16" Opacity="0.5" Margin="8,0" />
                                                        <Border Grid.Column="2" Classes="textbox" Background="{StaticResource AddedTint}" BorderBrush="{StaticResource AddedBorder}">
                                                            <local:DiffTextBlock Segments="{Binding ExampleAfter}" FontSize="15" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RuleCountText}" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Classes="tile" Background="{Binding Tint}">
                                                <i:Icon Value="{Binding Icon}" Foreground="{Binding Brush}" FontSize="19" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PersianName}" Classes="persian muted" FontSize="12"
                                                           HorizontalAlignment="Left" IsVisible="{Binding HasPersianName}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="chip" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Background="{Binding Tint}" IsVisible="{Binding HasFixes}">
                                                <TextBlock Text="{Binding FixCount}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                            </Border>
                                            <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                                          VerticalAlignment="Center" MinWidth="0" Margin="0,-6" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-target" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="CHECK" Classes="section" />
                        </StackPanel>
                        <RadioButton GroupName="scope" IsChecked="{Binding AllLines}" Content="All lines" />
                        <RadioButton GroupName="scope" IsChecked="{Binding SelectedLinesOnly}" Content="{Binding SelectedLinesText}"
                                     IsEnabled="{Binding HasSelectedLines}" />
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-eye-outline" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="DISPLAY" Classes="section" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding ShowHidden}" OnContent="Show hidden characters" OffContent="Show hidden characters" />
                        <Border Classes="card" Padding="12,10" IsVisible="{Binding ShowHidden}">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Text="·" FontWeight="Bold" FontSize="16" Foreground="{StaticResource HiddenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                                        <Run Text="Zero-width non-joiner " /><Run Text="(نیم‌فاصله)" FontFamily="{StaticResource PersianFont}" />
                                    </TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Text="RLE" FontWeight="Bold" FontSize="10" Foreground="{StaticResource HiddenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Direction marks (RLE, RLM, PDF, ...)" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Text="↵" FontWeight="Bold" FontSize="14" Foreground="{StaticResource HiddenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Changed line break" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Classes="card" Padding="14,12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="mdi-heart-outline" FontSize="15" Foreground="#EC4899" />
                                <TextBlock Text="Rules by Mohammad Sasan (msasanmh)" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Classes="muted">
                                <Run Text="{Binding TotalRuleCount, StringFormat='{}{0:N0}'}" /><Run Text=" find-and-replace rules from the Persian Subtitle Fixes plugin for Subtitle Edit 3/4." />
                            </TextBlock>
                            <Button Classes="link" Click="OnOpenHomepage" HorizontalAlignment="Left" Margin="-6,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="mdi-github" FontSize="14" />
                                    <TextBlock Text="msasanmh/PersianSubtitleFixes" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Fixes -->
        <DockPanel Margin="20,16,20,0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsVisible="{Binding HasFixes}">
                <TextBox Text="{Binding SearchText}" Watermark="Search text or line number" Width="320" HorizontalAlignment="Left">
                    <TextBox.InnerLeftContent>
                        <i:Icon Value="mdi-magnify" FontSize="16" Opacity="0.55" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="Select every visible fix">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-marked-outline" FontSize="16" />
                            <TextBlock Text="Select all" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="Clear the selection of the visible fixes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-blank-outline" FontSize="16" />
                            <TextBlock Text="None" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding InvertSelectionCommand}" ToolTip.Tip="Invert the selection of the visible fixes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-select-inverse" FontSize="16" />
                            <TextBlock Text="Invert" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Filters}" Margin="0,0,0,12" IsVisible="{Binding HasFixes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FilterChip">
                        <ToggleButton Classes="filter" Margin="0,0,6,6" IsChecked="{Binding IsActive, Mode=OneWay}"
                                      Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SetFilterCommand}"
                                      CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="{Binding Icon}" FontSize="14" Foreground="{Binding Brush}" />
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Opacity="0.6" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty states -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsClean}" HorizontalAlignment="Center"
                        Margin="0,120,0,0" Spacing="10">
                <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource FixTint}" HorizontalAlignment="Center">
                    <i:Icon Value="mdi-check-decagram-outline" FontSize="48" Foreground="{StaticResource FixBrush}" />
                </Border>
                <TextBlock Text="{Binding CleanTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CleanText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsFilteredEmpty}" HorizontalAlignment="Center"
                        Margin="0,100,0,0" Spacing="10">
                <i:Icon Value="mdi-magnify-close" FontSize="44" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="No fixes match the search" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox Classes="fixes" ItemsSource="{Binding VisibleFixes}" IsVisible="{Binding HasVisibleFixes}" Padding="0,0,8,6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:FixItem">
                        <Border Classes="fix" Classes.off="{Binding !IsSelected}">
                            <Grid ColumnDefinitions="4,Auto,*">
                                <Border Background="{Binding AccentBrush}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="12,10,0,0"
                                          ToolTip.Tip="Apply this fix" />
                                <StackPanel Grid.Column="2" Margin="6,12,14,12" Spacing="9">
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <Border Classes="badge" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Number}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeRange}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Groups}" HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Right" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:GroupOption">
                                                    <Border Classes="chip" Padding="8,2" Margin="6,0,0,0" Background="{Binding Tint}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <i:Icon Value="{Binding Icon}" FontSize="12" Foreground="{Binding Brush}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <Border Classes="textbox" Background="{StaticResource RemovedTint}" BorderBrush="{StaticResource RemovedBorder}">
                                            <local:DiffTextBlock Segments="{Binding BeforeSegments}" FontSize="16" TextWrapping="Wrap"
                                                                 ShowHidden="{Binding $parent[Window].((local:MainViewModel)DataContext).ShowHidden}" />
                                        </Border>
                                        <i:Icon Grid.Column="1" Value="mdi-arrow-right" FontSize="18" Opacity="0.45" Margin="10,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="textbox" Background="{StaticResource AddedTint}" BorderBrush="{StaticResource AddedBorder}">
                                            <local:DiffTextBlock Segments="{Binding AfterSegments}" FontSize="16" TextWrapping="Wrap"
                                                                 ShowHidden="{Binding $parent[Window].((local:MainViewModel)DataContext).ShowHidden}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
