<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:local="using:SubtitleEdit.Plugins.Transliterate"
        x:Class="SubtitleEdit.Plugins.Transliterate.MainWindow"
        x:DataType="local:MainViewModel"
        mc:Ignorable="d"
        Title="Transliterate"
        Width="1220" Height="860"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#0EA5E9" />
            <GradientStop Offset="1" Color="#6366F1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentTint" Color="#1F6366F1" />
        <SolidColorBrush x:Key="AccentBorder" Color="#996366F1" />
        <SolidColorBrush x:Key="FixBrush" Color="#2FA36B" />
        <SolidColorBrush x:Key="FixTint" Color="#1F2FA36B" />
        <SolidColorBrush x:Key="BeforeTint" Color="#0F808080" />
        <SolidColorBrush x:Key="AddedTint" Color="#142FA36B" />
        <SolidColorBrush x:Key="AddedBorder" Color="#402FA36B" />
        <SolidColorBrush x:Key="CardBrush" Color="#0C808080" />
        <SolidColorBrush x:Key="CardBorder" Color="#26808080" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14808080" />
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{StaticResource CardBorder}" />
        </Style>

        <!-- Language list -->
        <Style Selector="Button.lang">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.lang:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector="Button.lang.selected">
            <Setter Property="Background" Value="{StaticResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
        </Style>
        <Style Selector="Button.lang.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
        </Style>
        <Style Selector="Border.langtile">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Script boxes -->
        <Style Selector="Border.glyph">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.swap">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Segmented buttons -->
        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.segmented RadioButton">
            <Setter Property="Theme" Value="{DynamicResource {x:Type ToggleButton}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
        <Style Selector="Border.segmented ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Change list -->
        <Style Selector="ListBox.changes">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.changes ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.changes ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.changes ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.changes ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.change">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.change.off">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.textbox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                    <i:Icon Value="mdi-alphabetical-variant" FontSize="28" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Transliterate" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="Ж ↔ A · Ω → A · 한 → A" Classes="muted" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SubtitleInfo}" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="chip" Background="{StaticResource AccentTint}" IsVisible="{Binding HasDetected}"
                            ToolTip.Tip="Guessed from the letters used in the subtitle">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-radar" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                <Run Text="Detected: " /><Run Text="{Binding DetectedText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Classes="chip" Background="{StaticResource FixTint}" IsVisible="{Binding HasChanges}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-auto-fix" Foreground="{StaticResource FixBrush}" FontSize="15" />
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource FixBrush}">
                                <Run Text="{Binding ChangeCount}" /><Run Text=" lines to convert" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <i:Icon Value="mdi-information-outline" FontSize="16" Opacity="0.6" />
                    <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCancel" MinWidth="96">
                        <TextBlock Text="Cancel" HorizontalAlignment="Center" />
                    </Button>
                    <Button Click="OnOk" Classes="accent" MinWidth="110" IsDefault="True" IsEnabled="{Binding CanApply}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <i:Icon Value="mdi-check" FontSize="16" />
                            <TextBlock Text="OK" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Languages -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="14,16,16,16" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,4">
                        <i:Icon Value="mdi-earth" FontSize="16" Opacity="0.7" />
                        <TextBlock Text="LANGUAGE" Classes="section" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LanguageOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:LanguageOption">
                                <Button Classes="lang" Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectLanguageCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="langtile" Background="{Binding Tint}">
                                            <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="13" Foreground="{Binding Brush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NativeName}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                                            <Border Classes="chip" Padding="7,1" Background="{StaticResource AccentTint}" IsVisible="{Binding IsDetected}"
                                                    HorizontalAlignment="Right" ToolTip.Tip="Detected in the subtitle">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <i:Icon Value="mdi-radar" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="detected" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding ScriptText}" FontSize="10" Classes="muted" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Margin="22,18,22,0">

            <!-- Direction + example -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,14,*" Margin="0,0,0,14">
                <Border Classes="card" Padding="20,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-swap-horizontal" FontSize="16" Opacity="0.7" />
                            <TextBlock Classes="section"><Run Text="{Binding LanguageTitle}" /><Run Text=" · DIRECTION" /></TextBlock>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="glyph" Background="{Binding SelectedLanguage.Tint}">
                                    <TextBlock Text="{Binding FromGlyph}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding SelectedLanguage.Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Width="92">
                                    <TextBlock Text="FROM" Classes="section" FontSize="10" />
                                    <TextBlock Text="{Binding FromScript}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="swap" Margin="10,0,22,0" Command="{Binding SwapCommand}" IsEnabled="{Binding CanSwap}"
                                    ToolTip.Tip="{Binding SwapToolTip}" ToolTip.ShowOnDisabled="True">
                                <i:Icon Value="mdi-swap-horizontal" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                <Border Classes="glyph" Background="{StaticResource BrandGradient}">
                                    <TextBlock Text="{Binding ToGlyph}" FontSize="28" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Width="92">
                                    <TextBlock Text="TO" Classes="section" FontSize="10" />
                                    <TextBlock Text="{Binding ToScript}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="18,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-eye-outline" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="EXAMPLE" Classes="section" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ExampleBefore}" FontSize="14" TextWrapping="Wrap" Classes="muted" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="mdi-arrow-down" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ExampleAfter}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Options -->
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasSystems}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <i:Icon Value="mdi-format-letter-case" FontSize="16" Opacity="0.7" />
                        <TextBlock Text="SYSTEM" Classes="section" />
                    </StackPanel>
                    <Border Classes="segmented">
                        <ItemsControl ItemsSource="{Binding Systems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SystemOption">
                                    <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectSystemCommand}"
                                                  CommandParameter="{Binding}" ToolTip.Tip="{Binding Description}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding SystemDescription}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsFromLatin}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <i:Icon Value="mdi-shield-lock-outline" FontSize="16" Opacity="0.7" />
                        <TextBlock Text="KEEP IN LATIN" Classes="section" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding KeepWordsText}" Watermark="Words to leave in Latin, separated by commas"
                             ToolTip.Tip="Names, brands and abbreviations to leave as they are. Words with q, w, x or y and Roman numerals are always kept." />
                    <Button Grid.Column="2" Classes="link" Margin="6,0,0,0" Command="{Binding ResetKeepWordsCommand}" ToolTip.Tip="Restore the default list">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <i:Icon Value="mdi-restore" FontSize="14" />
                            <TextBlock Text="Reset" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Toolbar -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Border Classes="segmented" ToolTip.Tip="Which lines to convert">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton GroupName="scope" IsChecked="{Binding AllLines}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-text-box-multiple-outline" FontSize="15" />
                                <TextBlock Text="All lines" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="scope" IsChecked="{Binding SelectedLinesOnly}" IsEnabled="{Binding HasSelectedLines}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-target" FontSize="15" />
                                <TextBlock Text="{Binding SelectedLinesText}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasChanges}">
                    <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="Select every line">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-marked-outline" FontSize="16" />
                            <TextBlock Text="Select all" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="Clear the selection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-checkbox-multiple-blank-outline" FontSize="16" />
                            <TextBlock Text="None" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding InvertSelectionCommand}" ToolTip.Tip="Invert the selection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-select-inverse" FontSize="16" />
                            <TextBlock Text="Invert" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsClean}" HorizontalAlignment="Center"
                        Margin="0,50,0,0" Spacing="10">
                <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource AccentTint}" HorizontalAlignment="Center">
                    <i:Icon Value="mdi-text-search" FontSize="44" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock Text="Nothing to convert" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CleanText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Changes -->
            <ListBox Classes="changes" ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}" Padding="0,0,8,6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ChangeItem">
                        <Border Classes="change" Classes.off="{Binding !IsSelected}">
                            <Grid ColumnDefinitions="4,Auto,*">
                                <Border Background="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectedLanguage.Brush}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="12,10,0,0"
                                          ToolTip.Tip="Convert this line" />
                                <StackPanel Grid.Column="2" Margin="6,12,14,12" Spacing="9">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Classes="badge" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Number}" />
                                        </Border>
                                        <TextBlock Text="{Binding TimeRange}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <Border Classes="textbox" Background="{StaticResource BeforeTint}" BorderBrush="{StaticResource CardBorder}">
                                            <local:SubtitleTextBlock Segments="{Binding BeforeSegments}" FontSize="15" TextWrapping="Wrap" />
                                        </Border>
                                        <i:Icon Grid.Column="1" Value="mdi-arrow-right" FontSize="18" Opacity="0.45" Margin="10,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="textbox" Background="{StaticResource AddedTint}" BorderBrush="{StaticResource AddedBorder}">
                                            <local:SubtitleTextBlock Segments="{Binding AfterSegments}" FontSize="15" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
